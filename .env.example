# OpenClaw Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# CRITICAL - Telegram Bot Configuration (REQUIRED)
# ============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI API Key (for chat and system prompts)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Audio & Speech APIs - Choose at least ONE per category
# ============================================================================

# SPEECH-TO-TEXT (Audio Input)
# Option 1: Groq Whisper (Recommended - FREE, Fast, Accurate)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Deepgram (Free tier: 600 min/month)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Option 3: Google Cloud Speech-to-Text
GOOGLE_CLOUD_SPEECH_KEY=your_google_cloud_key_here

# ============================================================================
# TEXT-TO-SPEECH (Audio Output)
# Option 1: ElevenLabs (Recommended - FREE: 10K chars/month, High Quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Option 2: Google Cloud Text-to-Speech (FREE: 1M chars/month)
GOOGLE_API_KEY=your_google_api_key_here

# Option 3: Azure Cognitive Services Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ============================================================================
# System Configuration
# ============================================================================
# Dashboard & API Server
DASHBOARD_PORT=5000
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Python Dashboard
PYTHON_DASHBOARD_PORT=8080
PYTHON_DASHBOARD_HOST=localhost

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# ============================================================================
# Linux Mint / Desktop Configuration
# ============================================================================
ENVIRONMENT=production
SYSTEM_TYPE=desktop
OS_VERSION=mint-22.2

# ============================================================================
# Mobile / iPhone Configuration
# ============================================================================
# Set to true for mobile-optimized dashboard
MOBILE_MODE=false
DEVICE_TYPE=desktop

# ============================================================================
# Health Monitoring
# ============================================================================
HEALTH_CHECK_INTERVAL=60
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=80
ALERT_THRESHOLD_DISK=90

# ============================================================================
# Automation Settings
# ============================================================================
# Max execution time for workflows (seconds)
WORKFLOW_TIMEOUT=300

# Default language for audio processing
DEFAULT_LANGUAGE=en-US

# Form automation settings
FORM_FIELD_DETECTION_TIMEOUT=10
FORM_SUBMIT_WAIT_TIME=5

# ============================================================================
# Security & Authorization
# ============================================================================
# API Keys for dashboard authentication
DASHBOARD_API_KEY=your_secure_api_key_here
MASTER_PASSWORD=your_master_password_here

# JWT Secret (for session management)
JWT_SECRET=your_jwt_secret_here

# ============================================================================
# Advanced Settings
# ============================================================================
# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Audio quality settings
AUDIO_SAMPLE_RATE=16000
AUDIO_BIT_DEPTH=16
AUDIO_CHANNELS=1

# Telegram settings
TELEGRAM_POLLING_INTERVAL=1
TELEGRAM_REQUEST_TIMEOUT=30
TELEGRAM_PARSE_MODE=html

# Node.js environment
NODE_ENV=production

# Python environment
PYTHONUNBUFFERED=1
