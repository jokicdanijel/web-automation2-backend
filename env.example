# OpenClaw Dashboard - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# For systemd: copy to /home/danijel-jd/.openclaw/openclaw.env

# ==================== CORE CONFIGURATION ====================
# Server settings
OPENCLAW_HOST=192.168.0.140
OPENCLAW_PORT=5000
OPENCLAW_DEBUG=False
API_BASE_URL=http://192.168.0.140:5000

# ==================== TELEGRAM BOT ====================
# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=8767785519:AAGriBZlO7grk1kWeXouh3GqCYWs55kx3Ek
TELEGRAM_BOT_NAME=@openvlawbababab_bot

# Telegram Webhook Configuration
TELEGRAM_WEBHOOK_URL=http://192.168.0.140/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBHOOK_PORT=8787
TELEGRAM_WEBHOOK_HOST=127.0.0.1

# Telegram Stream Configuration
TELEGRAM_STREAM_MODE=partial
TELEGRAM_TEXT_CHUNK_LIMIT=15000
TELEGRAM_API_TIMEOUT=500

# Allowed Telegram Users (comma-separated user IDs)
TELEGRAM_ALLOWED_USERS=your_user_id_here
TELEGRAM_ADMIN_USERS=your_admin_id_here

# ==================== SPEECH-TO-TEXT (STT) ====================
# Groq Whisper API (Free tier available)
GROQ_API_KEY=your_groq_api_key_here

# Deepgram API (Free tier: 600 min/month)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ==================== TEXT-TO-SPEECH (TTS) ====================
# ElevenLabs (Free tier: 10K chars/month) - RECOMMENDED
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Cloud Text-to-Speech
GOOGLE_API_KEY=your_google_api_key_here

# Azure Cognitive Services Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ==================== AI/CHAT SERVICES ====================
# OpenAI API Key (for chat and system prompts)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Alternative: Use Vercel AI Gateway
VERCEL_AI_API_KEY=your_vercel_ai_key_here

# ==================== WEB AUTOMATION ====================
# Playwright/Selenium Configuration
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
HEADLESS_MODE=True
BROWSER_TIMEOUT=30000

# ==================== DATABASE ====================
# SQLite or PostgreSQL
DATABASE_URL=sqlite:////home/danijel-jd/.openclaw/openclaw.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=/home/danijel-jd/.openclaw/openclaw.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ==================== SECURITY ====================
# API Key for dashboard authentication
API_KEY=your_secure_api_key_here
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# CORS Configuration
CORS_ORIGINS=http://192.168.0.140:5000,http://127.0.0.1:5000,http://localhost:5000

# ==================== SYSTEM MONITORING ====================
# Health Check Settings
HEALTH_CHECK_INTERVAL=60
SYSTEM_ALERT_CPU_THRESHOLD=80
SYSTEM_ALERT_MEMORY_THRESHOLD=85
SYSTEM_ALERT_DISK_THRESHOLD=90

# ==================== NOTIFICATIONS ====================
# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=your_email@gmail.com

# Webhook Notifications
WEBHOOK_URL=http://192.168.0.140:8787/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# ==================== MOBILE DEVICE ====================
# iPhone 16 Pro Max Remote Connection
REMOTE_HOST=192.168.0.101
REMOTE_PORT=5001
REMOTE_AUTH_TOKEN=your_remote_token_here

# ==================== CACHE ====================
# Redis Cache (optional, for performance)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ==================== DEVELOPMENT ====================
# Development mode features
DEVELOPMENT_MODE=False
ENABLE_API_DOCS=True
ENABLE_PLAYGROUND=True
PROFILING_ENABLED=False

# ==================== DEPRECATED ====================
# Legacy configuration (keeping for backwards compatibility)
OLD_API_KEY=deprecated
