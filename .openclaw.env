# OpenClaw Dashboard - Systemd Service Environment File
# Location: /home/danijel-jd/.openclaw/openclaw.env
# Used by: /etc/systemd/system/openclaw.service

# ==================== CORE CONFIGURATION ====================
OPENCLAW_HOST=192.168.0.140
OPENCLAW_PORT=5000
OPENCLAW_DEBUG=False
API_BASE_URL=http://192.168.0.140:5000

# ==================== TELEGRAM BOT ====================
TELEGRAM_BOT_TOKEN=8767785519:AAGriBZlO7grk1kWeXouh3GqCYWs55kx3Ek
TELEGRAM_BOT_NAME=@openvlawbababab_bot
TELEGRAM_WEBHOOK_URL=http://192.168.0.140/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=!
TELEGRAM_WEBHOOK_PORT=8787
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_STREAM_MODE=partial
TELEGRAM_TEXT_CHUNK_LIMIT=15000
TELEGRAM_API_TIMEOUT=500
TELEGRAM_ALLOWED_USERS=your_telegram_user_id
TELEGRAM_ADMIN_USERS=your_telegram_admin_id

# ==================== PRIMARY APIs ====================
# Speech Services (choose at least one)
GROQ_API_KEY=your_groq_key
ELEVENLABS_API_KEY=your_elevenlabs_key
OPENAI_API_KEY=your_openai_key

# ==================== SECONDARY APIs ====================
# Fallback options (optional)
DEEPGRAM_API_KEY=your_deepgram_key
GOOGLE_API_KEY=your_google_key
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=eastus

# ==================== SECURITY ====================
API_KEY=your_secure_api_key_here
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=/home/danijel-jd/.openclaw/openclaw.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ==================== SYSTEM ====================
DATABASE_URL=sqlite:////home/danijel-jd/.openclaw/openclaw.db
DEVELOPMENT_MODE=False
ENABLE_API_DOCS=True

# ==================== MONITORING ====================
HEALTH_CHECK_INTERVAL=60
SYSTEM_ALERT_CPU_THRESHOLD=80
SYSTEM_ALERT_MEMORY_THRESHOLD=85
